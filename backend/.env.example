# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Database Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/taskmanager
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/taskmanager?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager

# JWT Secret Key and Expiration
JWT_SECRET=super_secret_jwt_key_task_management_2026
JWT_EXPIRE=30d

# Cloudinary Credentials (For task file/image attachments)
# Sign up at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenWeatherMap API Key (For live weather integration)
# Get free API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Nodemailer / Email Service Credentials (For task creation & completion notifications)
# Option 1: Gmail App Password
# Option 2: Resend / SendGrid / Custom SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=TaskFlow Notification <no-reply@taskflow.app>
